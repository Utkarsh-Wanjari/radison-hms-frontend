pipeline{
    agent any
    stages{
        stage("PULL"){
            steps{
                git branch: 'dev', url: 'https://github.com/Utkarsh-Wanjari/radison-hms-frontend.git'
            }
        }
        stage("BUILD"){
            steps{
                sh '''npm install
                        npm run build'''
            }
        }
        stage("DEPLOY"){
            steps{
               withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh '''
                    aws s3 sync dist/ s3://radison-frontend-bucket
                 '''
}
            }
        }
    }
}
